{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "lib/**/*.ts",
    "components/**/*.tsx",
    "api/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
